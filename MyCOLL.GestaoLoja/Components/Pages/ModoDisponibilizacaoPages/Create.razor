@page "/mododisponibilizacaos/create"
@using Microsoft.EntityFrameworkCore
@using MyCOLL.Shared
@inject IDbContextFactory<MyCOLL.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, Funcionario")]

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>ModoDisponibilizacao</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="ModoDisponibilizacao" OnValidSubmit="AddModoDisponibilizacao" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="nome" class="form-label">Nome:</label> 
                <InputText id="nome" @bind-Value="ModoDisponibilizacao.Nome" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => ModoDisponibilizacao.Nome" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="detalhe" class="form-label">Detalhe:</label> 
                <InputText id="detalhe" @bind-Value="ModoDisponibilizacao.Detalhe" class="form-control" /> 
                <ValidationMessage For="() => ModoDisponibilizacao.Detalhe" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="ativo" class="form-label">Ativo:</label> 
                <InputCheckbox id="ativo" @bind-Value="ModoDisponibilizacao.Ativo" class="form-check-input" /> 
                <ValidationMessage For="() => ModoDisponibilizacao.Ativo" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/mododisponibilizacaos">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private ModoDisponibilizacao ModoDisponibilizacao { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddModoDisponibilizacao()
    {
        using var context = DbFactory.CreateDbContext();
        context.ModosDisponibilizacao.Add(ModoDisponibilizacao);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/mododisponibilizacaos");
    }
}
