@page "/login"
@using MyCOLL.Shared.DTOs
@using MyCOLL.RCL.Services
@inject ApiService Api
@inject NavigationManager Nav

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    
                    <div class="text-center mb-4">
                        <i class="bi bi-person-circle display-1 text-primary"></i>
                        <h3 class="fw-bold mt-2">Bem-vindo</h3>
                        <p class="text-muted">Inicie sessão para continuar</p>
                    </div>

                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger py-2 small">
                            <i class="bi bi-exclamation-circle me-1"></i> @mensagemErro
                        </div>
                    }
                    
                    @if (registadoRecentemente)
                    {
                        <div class="alert alert-success py-2 small">
                            <i class="bi bi-check-circle me-1"></i> Registo efetuado! Pode entrar.
                        </div>
                    }

                    <EditForm Model="LoginModel" OnValidSubmit="HandleLogin">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <InputText @bind-Value="LoginModel.Email" class="form-control" placeholder="exemplo@email.com" />
                            </div>
                            <ValidationMessage For="@(() => LoginModel.Email)" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                                <InputText @bind-Value="LoginModel.Password" type="password" class="form-control" placeholder="******" />
                            </div>
                            <ValidationMessage For="@(() => LoginModel.Password)" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm" disabled="@processando">
                            @if (processando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>A entrar...</span>
                            }
                            else
                            {
                                <span>Entrar</span> <i class="bi bi-arrow-right ms-1"></i>
                            }
                        </button>
                    </EditForm>

                    <hr class="my-4 text-secondary" />

                    @* --- LIGAÇÃO PARA A PÁGINA DE REGISTO --- *@
                    <div class="text-center">
                        <span class="text-muted">Ainda não tem conta?</span>
                        <div class="mt-2">
                            <a href="registar" class="btn btn-outline-primary w-100 fw-bold">
                                <i class="bi bi-pencil-square me-1"></i> Criar Conta Nova
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginDto LoginModel = new();
    private string? mensagemErro;
    private bool processando = false;
    private bool registadoRecentemente = false;

    // Capturar parâmetros da URL (ex: ?registado=true ou ?returnUrl=...)
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery] 
    public bool? Registado { get; set; }

    protected override void OnInitialized()
    {
        if (Registado == true)
        {
            registadoRecentemente = true;
        }
    }

    private async Task HandleLogin()
    {
        processando = true;
        mensagemErro = null;

        try
        {
            var erro = await Api.Login(LoginModel);
            if (erro == null)
            {
                // Login com sucesso!
                // Se houver URL de retorno, volta para lá (ex: Carrinho), senão vai para a Home
                Nav.NavigateTo(ReturnUrl ?? "/");
            }
            else
            {
                mensagemErro = erro; // Ex: "Credenciais inválidas" ou "Conta pendente"
            }
        }
        catch (Exception)
        {
            mensagemErro = "Erro de comunicação com o servidor.";
        }
        finally
        {
            processando = false;
        }
    }
}