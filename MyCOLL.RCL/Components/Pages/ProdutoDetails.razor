@page "/produto/{Id:int}"
@using MyCOLL.Shared
@using MyCOLL.RCL.Services
@using MyCOLL.Shared.Enums
@inject ApiService ApiService
@inject CarrinhoService CarrinhoSvc
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>MyCOLL - Detalhes</PageTitle>

@if (Produto == null)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
    </div>
}
else
{
    <div class="container mt-4 mb-5 animate-fade-in">
        @* Botão Voltar *@
        <button class="btn btn-link text-decoration-none mb-3 ps-0" @onclick='() => NavManager.NavigateTo("/")'>
            <i class="bi bi-arrow-left"></i> Voltar à Loja
        </button>

        <div class="row gx-5">
            @* Coluna Imagem *@
            <div class="col-md-6 mb-4">
                <div class="card border-0 shadow-sm overflow-hidden">
                    @if (!string.IsNullOrEmpty(Produto.ImagemUrl))
                    {
                        <img src="@ObterImagemSrc(Produto.ImagemUrl)" class="img-fluid w-100" style="object-fit: contain; max-height: 500px;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 400px;">
                            <i class="bi bi-image display-1"></i>
                        </div>
                    }
                </div>
            </div>

            @* Coluna Detalhes *@
            <div class="col-md-6">
                <div class="mb-2">
                    <span class="badge bg-secondary rounded-pill px-3 py-2">@Produto.Categoria?.Nome</span>
                    @if (Produto.ModoDisponibilizacao != null)
                    {
                        <span class="badge bg-info text-dark rounded-pill px-3 py-2 ms-1">@Produto.ModoDisponibilizacao.Nome</span>
                    }
                </div>

                <h1 class="fw-bold display-6 mb-3">@Produto.Nome</h1>

                <h2 class="text-primary fw-bold mb-4">@Produto.PrecoVenda.ToString("C2")</h2>

                <p class="text-muted fs-5 mb-4" style="white-space: pre-line;">@Produto.Descricao</p>

                <hr class="my-4 text-secondary" />

                <div class="d-flex align-items-center gap-3">
                    @if (Produto.Estado == EstadoProduto.Ativo)
                    {
                        @if (Produto.Stock > 0)
                        {
                            <button class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill" @onclick="AdicionarAoCarrinho">
                                <i class="bi bi-cart-plus me-2"></i> Adicionar ao Carrinho
                            </button>
                            <span class="text-success fw-bold ms-2">
                                <i class="bi bi-check-circle-fill me-1"></i> Em Stock (@Produto.Stock)
                            </span>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg px-5 rounded-pill" disabled>Esgotado</button>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning w-100">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Este produto encontra-se indisponível.
                        </div>
                    }
                </div>

                <div class="mt-5 p-3 bg-light rounded-3">
                    <small class="text-muted d-block">
                        <i class="bi bi-shop me-1"></i> Vendido por: <strong>@(FornecedorNome)</strong>
                    </small>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private Produto? Produto;
    // Removemos ApiBaseUrl fixa. Usamos ApiService.UrlApi
    private string FornecedorNome = "Loja Oficial";

    protected override async Task OnInitializedAsync()
    {
        Produto = await ApiService.GetProdutoDetalhe(Id);

        // Verifica a propriedade auxiliar que criámos
        if (!string.IsNullOrEmpty(Produto?.FornecedorNomeAuxiliar))
        {
            FornecedorNome = Produto.FornecedorNomeAuxiliar;
        }
        else
        {
            FornecedorNome = "Loja Oficial (MyCOLL)";
        }
    }

    private async Task AdicionarAoCarrinho()
    {
        if (Produto != null)
        {
            await JS.InvokeVoidAsync("alert", $"'{Produto.Nome}' adicionado ao carrinho!");
            await CarrinhoSvc.Adicionar(Produto);
            
            // NavManager.NavigateTo("/carrinho");
            NavManager.NavigateTo("/"); // Volta à Home 
        }
    }

    private string ObterImagemSrc(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return url;
        return $"{ApiService.UrlApi}{url}";
    }
}