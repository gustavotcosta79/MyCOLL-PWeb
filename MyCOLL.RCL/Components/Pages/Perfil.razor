@page "/perfil"
@using MyCOLL.Shared.DTOs
@using MyCOLL.RCL.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiService Api
@inject NavigationManager Nav

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-lines-fill me-2"></i>O Meu Perfil</h4>
                </div>
                <div class="card-body p-4">

                    @if (carregando)
                    {
                        <div class="text-center"><div class="spinner-border text-primary"></div></div>
                    }
                    else
                    {
                        @if (sucesso)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> Dados atualizados com sucesso!
                                <button type="button" class="btn-close" @onclick="() => sucesso = false"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensagemErro))
                        {
                            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i> @mensagemErro</div>
                        }

                        <EditForm Model="MeuPerfil" OnValidSubmit="Gravar">
                            <DataAnnotationsValidator />

                            @* Email (Read-only) *@
                            <div class="mb-3">
                                <label class="form-label text-muted">Email (não editável)</label>
                                <input class="form-control bg-light" value="@MeuPerfil.Email" readonly />
                            </div>

                            @* Nome *@
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nome Completo</label>
                                <InputText @bind-Value="MeuPerfil.Nome" class="form-control" />
                                <ValidationMessage For="@(() => MeuPerfil.Nome)" />
                            </div>

                            <div class="row mb-3">
                                @* NIF *@
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">NIF</label>
                                    <InputText @bind-Value="MeuPerfil.NIF" class="form-control" />
                                    <ValidationMessage For="@(() => MeuPerfil.NIF)" />
                                </div>
                            </div>

                            @* Morada *@
                            <div class="mb-4">
                                <label class="form-label fw-bold">Morada</label>
                                <InputTextArea @bind-Value="MeuPerfil.Morada" class="form-control" rows="2" />
                                <ValidationMessage For="@(() => MeuPerfil.Morada)" />
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <a href="/" class="btn btn-outline-secondary">Voltar</a>
                                <button type="submit" class="btn btn-primary px-4 fw-bold" disabled="@processando">
                                    @if (processando)
                                    {
                                        <span>A gravar...</span>
                                    }
                                    else
                                    {

                                        <span>Gravar Alterações</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PerfilDto MeuPerfil = new();
    private bool carregando = true;
    private bool processando = false;
    private bool sucesso = false;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        var dados = await Api.GetMeuPerfil();
        if (dados != null)
        {
            MeuPerfil = dados;
            carregando = false;
        }
        else
        {
            mensagemErro = "Não foi possível carregar o seu perfil.";
            carregando = false;
        }
    }

    private async Task Gravar()
    {
        processando = true;
        mensagemErro = null;
        sucesso = false;

        var erro = await Api.AtualizarPerfil(MeuPerfil);

        if (erro == null)
        {
            sucesso = true;
        }
        else
        {
            mensagemErro = $"Erro: {erro}";
        }

        processando = false;
    }
}