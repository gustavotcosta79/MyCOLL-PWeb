@page "/carrinho"
@using MyCOLL.Shared
@using MyCOLL.RCL.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MyCOLL.Shared.Enums
@inject CarrinhoService CarrinhoSvc
@inject ApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>MyCOLL - O meu Carrinho</PageTitle>

<div class="container mt-4 mb-5">
    <h3 class="mb-4 fw-bold text-primary"><i class="bi bi-cart3 me-2"></i>O meu Carrinho</h3>

    @if (aCarregar)
    {
        @* Mostra spinner enquanto lê o LocalStorage (evita piscar "Vazio" erradamente) *@
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">A carregar carrinho...</p>
        </div>
    }
    else if (itens == null || !itens.Any())
    {
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-basket display-1 text-muted mb-3"></i>
            <h4 class="text-secondary">O seu carrinho está vazio.</h4>
            <p class="mb-4">Explore o nosso catálogo e encontre itens únicos para a sua coleção.</p>
            <a href="/" class="btn btn-primary btn-lg rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar à Loja
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @* --- TABELA DE ITENS --- *@
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-secondary">
                                    <tr>
                                        <th scope="col" class="ps-4">Produto</th>
                                        <th scope="col" class="text-center">Preço</th>
                                        <th scope="col" class="text-center" style="width: 140px;">Qtd.</th>
                                        <th scope="col" class="text-center">Total</th>
                                        <th scope="col" class="text-end pe-4">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in itens)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.Produto.ImagemUrl))
                                                    {
                                                        <img src="@($"{Api.UrlApi}{item.Produto.ImagemUrl}")"
                                                             class="rounded me-3 border"
                                                             style="width: 50px; height: 50px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded me-3 bg-secondary d-flex align-items-center justify-content-center text-white"
                                                             style="width: 50px; height: 50px;">
                                                            <i class="bi bi-image"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <h6 class="mb-0 text-truncate" style="max-width: 200px;" title="@item.Produto.Nome">
                                                            @item.Produto.Nome
                                                        </h6>
                                                        <small class="text-muted">@item.Produto.Categoria?.Nome</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center text-muted">
                                                @item.Produto.PrecoVenda.ToString("C2")
                                            </td>
                                            <td class="text-center">
                                                <div class="input-group input-group-sm justify-content-center">
                                                    <button class="btn btn-outline-secondary" type="button"
                                                            @onclick="() => AlterarQuantidade(item, -1)">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="text" class="form-control text-center bg-white"
                                                           value="@item.Quantidade" readonly style="max-width: 50px;">
                                                    <button class="btn btn-outline-secondary" type="button"
                                                            @onclick="() => AlterarQuantidade(item, 1)">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-center fw-bold text-dark">
                                                @((item.Produto.PrecoVenda * item.Quantidade).ToString("C2"))
                                            </td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-link text-danger p-0"
                                                        title="Remover"
                                                        @onclick="() => RemoverItem(item)">
                                                    <i class="bi bi-trash fs-5"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            @* --- RESUMO DA ENCOMENDA --- *@
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Resumo</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal (@CarrinhoSvc.ContarItens() itens)</span>
                            <span class="fw-bold">@CarrinhoSvc.Total().ToString("C2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-muted">Envio</span>
                            <span class="text-success">Grátis</span>
                        </div>

                        <hr class="mb-4">

                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold">Total</span>
                            <span class="h4 fw-bold text-primary">@CarrinhoSvc.Total().ToString("C2")</span>
                        </div>

                        @* Lógica de Botão de Compra *@
                        <AuthorizeView>
                            <Authorized>
                                <button class="btn btn-primary w-100 py-2 fw-bold shadow-sm mb-2"
                                        @onclick="FinalizarCompra"
                                        disabled="@processando">
                                    @if (processando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>A processar...</span>
                                    }
                                    else
                                    {
                                        <span>Finalizar Compra</span>
                                    }
                                </button>
                            </Authorized>
                            <NotAuthorized>
                                <a href="login?returnUrl=/carrinho" class="btn btn-outline-primary w-100 py-2 fw-bold">
                                    <i class="bi bi-person-lock me-2"></i>Faça Login para Comprar
                                </a>
                                <div class="text-center mt-2">
                                    <small class="text-muted">Ainda não tem conta? <a href="registar">Registe-se aqui</a></small>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>

                        @if (!string.IsNullOrEmpty(mensagemErro))
                        {
                            <div class="alert alert-danger mt-3 mb-0 py-2 small">
                                <i class="bi bi-exclamation-circle me-1"></i> @mensagemErro
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CarrinhoItem> itens = new();
    private bool processando = false;
    private bool aCarregar = true; // Variável nova
    private string? mensagemErro;

    // --- AQUI ESTÁ A MUDANÇA PRINCIPAL ---
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Garante que o serviço do carrinho lê do LocalStorage agora que o browser está pronto
            await CarrinhoSvc.Inicializar();
            CarregarItens();
            aCarregar = false;

            // Subscrever evento para atualizar UI se algo mudar externamente
            CarrinhoSvc.OnChange += StateHasChanged;

            StateHasChanged(); // Atualiza o ecrã
        }
    }

    private void CarregarItens()
    {
        itens = CarrinhoSvc.ObterItens();
    }

    private async Task AlterarQuantidade(CarrinhoItem item, int delta)
    {
        int novaQtd = item.Quantidade + delta;

        if (novaQtd < 1) return; // Não permite 0 ou negativo via botões +/-

        //Atualiza o objeto local
        item.Quantidade = novaQtd;

        // Chama o Adicionar com 0 para disparar o "Guardar" no serviço sem somar extra
        await CarrinhoSvc.Adicionar(item.Produto, 0);
    }

    private async Task RemoverItem(CarrinhoItem item)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Tem a certeza que deseja remover este item?"))
        {
            await CarrinhoSvc.Remover(item.Produto);
            CarregarItens(); // Refresh na lista local
        }
    }

    private async Task FinalizarCompra()
    {
        processando = true;
        mensagemErro = null;

        try
        {
            // Criar objeto Encomenda
            var novaEncomenda = new Encomenda
            {
                DataEncomenda = DateTime.Now,
                Estado = EstadoEncomenda.Pendente,
                Detalhes = itens.Select(i => new DetalheEncomenda
                {
                    ProdutoId = i.Produto.Id,
                    PrecoUnitario = i.Produto.PrecoVenda,
                    Quantidade = i.Quantidade
                }).ToList()
            };

            var sucesso = await Api.EnviarEncomenda(novaEncomenda);

            if (sucesso)
            {
                await CarrinhoSvc.Limpar();
                Nav.NavigateTo("/encomendas/meuspedidos"); // Redireciona para histórico
            }
            else
            {
                mensagemErro = "Ocorreu um erro ao processar a encomenda. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro de comunicação com o servidor.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            processando = false;
        }
    }

    public void Dispose()
    {
        CarrinhoSvc.OnChange -= StateHasChanged;
    }
}