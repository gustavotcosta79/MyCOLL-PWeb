@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using MyCOLL.RCL.Services
@inject NavigationManager NavManager
@inject CarrinhoService Carrinho
@inject ApiService Api
@implements IDisposable

<div class="page">
    <main>
        @* --- HEADER / NAVBAR SUPERIOR --- *@
        @* 'fixed-top' mantém o menu sempre visível ao fazer scroll *@
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary px-4 shadow-sm fixed-top">
            <div class="container-fluid">

                @* 1. LOGO (Esquerda) *@
                <a class="navbar-brand fw-bold fs-3 d-flex align-items-center gap-2" href="">
                    <i></i> MyCOLL
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    @* 2. MENU DIREITA (Carrinho + User) *@
                    @* 'ms-auto' empurra este bloco totalmente para a direita *@
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-3">

                        @* ÍCONE DO CARRINHO *@
                        <li class="nav-item">
                            <a class="nav-link text-white position-relative" href="carrinho" title="Ver Carrinho">
                                <i class="bi bi-cart3 fs-4"></i>

                                @* BADGE VERMELHO: Só aparece se houver itens *@
                                @if (Carrinho.ContarItens() > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light">
                                        @Carrinho.ContarItens()
                                        <span class="visually-hidden">itens no carrinho</span>
                                    </span>
                                }
                            </a>
                        </li>

                        @* ÁREA DE UTILIZADOR (Auth) *@
                        <AuthorizeView>
                            <Authorized>
                                <li class="nav-item dropdown">
                                    @* Botão que abre o menu *@
                                    <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                      
                                    </a>

                                    @* Lista de Opções *@
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 animate-slide-in">
                                        @* Perfil *@
                                        <li>
                                            <a class="dropdown-item py-2" href="perfil">
                                                <i class="bi bi-person-lines-fill me-2 text-primary"></i>O Meu Perfil
                                            </a>
                                        </li>

                                        @* Encomendas *@
                                        <AuthorizeView Roles="Cliente" Context="innerContext">
                                        <li>
                                            <a class="dropdown-item py-2" href="encomendas/meuspedidos">
                                                <i class="bi bi-bag-check-fill me-2 text-primary"></i>Minhas Encomendas
                                            </a>
                                        </li>
                                        </AuthorizeView>

                                        @* Link Exclusivo para Fornecedores/Admins *@
                                        <AuthorizeView Roles="Fornecedor" Context="innerContext">
                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header text-uppercase small">Área de Vendedor</h6></li>
                                            <li>
                                                <a class="dropdown-item py-2" href="fornecedor/produtos">
                                                    <i class="bi bi-box-seam-fill me-2 text-success"></i>Gerir Produtos
                                                </a>
                                                <a class="dropdown-item py-2" href="fornecedor/vendas">
                                                    <i class="bi bi-box-seam-fill me-2 text-success"></i>Gerir Vendas
                                                </a>
                                            </li>
                                        </AuthorizeView>

                                        <li><hr class="dropdown-divider"></li>

                                        @* Logout *@
                                        <li>
                                            <button class="dropdown-item py-2 text-danger fw-bold" @onclick="Logout">
                                                <i class="bi bi-box-arrow-right me-2"></i>Sair
                                            </button>
                                        </li>
                                    </ul>
                                </li>
                            </Authorized>
                            <NotAuthorized>
                                <li class="nav-item">
                                    <a class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm" href="login">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                                    </a>
                                </li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </div>
            </div>
        </nav>

        @* --- CONTEÚDO DA PÁGINA --- *@
        <div class="container" style="margin-top: 85px; padding-bottom: 40px;">
            @Body
        </div>
    </main>
</div>

<style>
    .animate-slide-in {
        animation: slideIn 0.2s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Carrinho.Inicializar();
            Carrinho.OnChange += StateHasChanged;
            StateHasChanged();
        }
    }

    private async Task Logout()
    {
        await Api.Logout();
        NavManager.NavigateTo("/", true);
    }

    public void Dispose()
    {
        Carrinho.OnChange -= StateHasChanged;
    }
}